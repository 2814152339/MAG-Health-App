# REQUIRED: generate independently for this installation; never commit a token.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
RUYUAN_API_TOKEN=
RUYUAN_DATA_DIR=./private-data
RUYUAN_WORKERS=1
# Optional, explicitly operator-authorized Face Landmarker .task file (absolute).
RUYUAN_FACE_MODEL=
# Docker only: set true to install optional face runtime during the build.
INSTALL_MEDIAPIPE=false
